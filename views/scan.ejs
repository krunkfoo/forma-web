<%- include('layout', { title: scan.name + ' — Forma', body: `
<div class="scan-viewer-page">
  <div class="scan-viewer-header">
    <div class="scan-viewer-title-row">
      <div>
        <h1 class="scan-viewer-title">${scan.name}</h1>
        <div class="scan-viewer-meta">
          <span class="scan-type-badge scan-type-${scan.space_type}">
            ${scan.space_type === 'interior' ? 'Interior' : 'Outdoor'}
          </span>
          ${scan.area_m2 ? `<span class="scan-area">${Math.round(scan.area_m2)} m²</span>` : ''}
        </div>
      </div>
      <div class="scan-viewer-actions" id="viewerActions">
        <button class="btn-ghost" id="editBtn" onclick="startEdit()">Edit plan</button>
      </div>
      <div class="scan-viewer-actions" id="editorActions" style="display:none">
        <button class="btn-ghost" onclick="PlanEditor.cancel()">Cancel</button>
        <button class="btn-primary" id="saveBtn" onclick="PlanEditor.save()">Save</button>
      </div>
    </div>
  </div>

  <div class="scan-canvas-wrap">
    <canvas id="planCanvas"></canvas>

    <div class="plan-legend" id="planLegend">
      ${scan.space_type === 'interior' ? `
        <div class="legend-item"><span class="legend-swatch" style="background:#e8e8e8;border:none"></span>Walls</div>
        <div class="legend-item"><span class="legend-swatch" style="background:none;border:2px dashed #4a9eff"></span>Doors</div>
        <div class="legend-item"><span class="legend-swatch" style="background:none;border:2px dashed #33E566"></span>Windows</div>
        <div class="legend-item"><span class="legend-swatch" style="background:rgba(255,200,80,0.35);border:1px solid rgba(255,200,80,0.7)"></span>Furniture</div>
      ` : `
        <div class="legend-item"><span class="legend-swatch" style="background:rgba(51,229,102,0.2);border:2px solid #33E566"></span>Boundary</div>
        <div class="legend-item"><span class="legend-swatch" style="background:#aaa;border:none"></span>Walls</div>
        <div class="legend-item"><span class="legend-swatch" style="background:rgba(60,180,60,0.7);border:none;border-radius:50%"></span>Trees / Shrubs</div>
        <div class="legend-item"><span class="legend-swatch" style="background:rgba(160,140,100,0.5);border:none"></span>Hardscape</div>
      `}
    </div>
  </div>
</div>

<div class="ai-assistant" id="aiAssistant">
  <div class="ai-header" onclick="toggleAI()">
    <span>✦ Design Assistant</span>
    <span class="ai-toggle-icon" id="aiToggleIcon">▲</span>
  </div>
  <div class="ai-body" id="aiBody">
    <div class="ai-messages" id="aiMessages">
      <div class="ai-msg ai-msg-bot">Hi! I can see your scan data. Ask me anything — furniture arrangement, plant suggestions, design ideas…</div>
    </div>
    <div class="ai-input-row">
      <input type="text" id="aiInput" class="ai-input" placeholder="Ask a design question…" onkeydown="if(event.key==='Enter')sendAI()">
      <button class="btn-primary ai-send-btn" onclick="sendAI()">Send</button>
    </div>
    <div class="ai-suggestions">
      <button class="ai-chip" onclick="askAI('How should I rearrange this furniture for better flow?')">Better flow</button>
      <button class="ai-chip" onclick="askAI('What color scheme would work best in this space?')">Color ideas</button>
      <button class="ai-chip" onclick="askAI('What plants would work well in this outdoor space?')">Plant ideas</button>
      <button class="ai-chip" onclick="askAI('How can I make this space feel larger?')">Feel larger</button>
    </div>
  </div>
</div>

<script>
  window.SCAN_DATA = ${JSON.stringify({
    id:            scan.id,
    space_type:    scan.space_type,
    area_m2:       scan.area_m2,
    room_snapshot: scan.room_snapshot,
    site_plan:     scan.site_plan,
    scan_metadata: scan.scan_metadata
  })};
  window.SCAN_ID = '${scan.id}';

  function startEdit() {
    document.getElementById('viewerActions').style.display = 'none';
    document.getElementById('editorActions').style.display = 'flex';
    document.getElementById('planLegend').style.display = 'none';
    if (window.SCAN_DATA.space_type === 'interior') {
      window.PlanEditor.activate(window.SCAN_DATA);
    } else {
      window.PlanEditor.activateOutdoor(window.SCAN_DATA);
    }
  }

  window.addEventListener('planEditorDeactivated', function() {
    document.getElementById('viewerActions').style.display = 'flex';
    document.getElementById('editorActions').style.display = 'none';
    document.getElementById('planLegend').style.display = '';
  });

  var aiOpen = true;
  function toggleAI() {
    aiOpen = !aiOpen;
    document.getElementById('aiBody').style.display = aiOpen ? 'flex' : 'none';
    document.getElementById('aiToggleIcon').textContent = aiOpen ? '▲' : '▼';
  }
  function askAI(text) {
    document.getElementById('aiInput').value = text;
    sendAI();
  }
  function sendAI() {
    var input = document.getElementById('aiInput');
    var msg = input.value.trim();
    if (!msg) return;
    input.value = '';
    appendMsg(msg, 'user');
    var thinking = appendMsg('Thinking…', 'bot');
    fetch('/api/scans/' + window.SCAN_ID + '/suggest', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ message: msg })
    }).then(function(r) { return r.json(); }).then(function(d) {
      thinking.textContent = d.reply || d.error || 'No response';
    }).catch(function() {
      thinking.textContent = 'Connection error. Try again.';
    });
  }
  function appendMsg(text, role) {
    var msgs = document.getElementById('aiMessages');
    var div = document.createElement('div');
    div.className = 'ai-msg ai-msg-' + (role === 'user' ? 'user' : 'bot');
    div.textContent = text;
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }
</script>
<script src="/js/plan-viewer.js"></script>
<script src="/js/plan-editor.js"></script>
` }) %>
